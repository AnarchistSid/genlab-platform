[Unit]
Description=GenLab Strategist actions applier — materialise accepted arm_add proposals
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service
# Fire AFTER Sunday's Strategist run + a review buffer
After=genlab-strategist.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
# File-path invocation — see sibling ``genlab-late-reward.service``
# for the same fix. ``scripts/`` is not a Python package (no
# ``__init__.py``), so ``-m scripts.apply_strategist_actions`` fails
# at import — caught by ``test_systemd_module_drift.py``.
ExecStart=/usr/local/bin/uv run python scripts/apply_strategist_actions.py
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=30

[Install]
WantedBy=multi-user.target
