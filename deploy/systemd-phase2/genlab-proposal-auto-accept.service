[Unit]
Description=GenLab strategist proposal auto-accepter — low-risk arm_add classifier
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service
# Run after the strategist itself so we pick up fresh proposals.
After=genlab-strategist.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
ExecStart=/usr/local/bin/uv run python scripts/auto_accept_strategist_proposals.py --apply
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=30

[Install]
WantedBy=multi-user.target
