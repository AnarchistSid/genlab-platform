{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feedback Report",
  "description": "Output of process_feedback.py — summarizes feedback ingestion and config adjustments",
  "type": "object",
  "required": ["generated_at", "feedback_window", "items_processed", "config_changes", "summary"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "feedback_window": {
      "type": "object",
      "properties": {
        "since": {"type": "string", "format": "date"},
        "until": {"type": "string", "format": "date"}
      },
      "required": ["since", "until"]
    },
    "items_processed": {
      "type": "integer",
      "minimum": 0
    },
    "issue_counts": {
      "type": "object",
      "description": "Count of each issue type seen",
      "additionalProperties": {"type": "integer"}
    },
    "action_counts": {
      "type": "object",
      "description": "Count of each action_taken value",
      "additionalProperties": {"type": "integer"}
    },
    "config_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "change_type", "description"],
        "properties": {
          "file": {"type": "string"},
          "change_type": {
            "type": "string",
            "enum": ["topic_weight_decay", "template_flagged", "constraint_tightened", "scoring_adjusted"]
          },
          "key": {"type": "string"},
          "old_value": {},
          "new_value": {},
          "description": {"type": "string"},
          "trigger_count": {
            "type": "integer",
            "description": "Number of feedback signals that triggered this change"
          }
        }
      }
    },
    "flagged_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {"type": "string"},
          "issue": {"type": "string"},
          "count": {"type": "integer"}
        }
      },
      "description": "Templates flagged for manual review"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_config_changes": {"type": "integer"},
        "topic_weights_adjusted": {"type": "integer"},
        "templates_flagged": {"type": "integer"},
        "constraints_tightened": {"type": "integer"}
      }
    }
  }
}
