[Unit]
Description=GenLab AI Creators Pipeline (BlackboxBrief)
After=network-online.target docker.service
Wants=network-online.target

# Surface unit failures to the dashboard CriticalAlertsBanner
# (2026-06-16 outage prevention). Template unit lives at
# scripts/systemd_failure_alert.sh.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab/BlackboxBrief
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
# Task #35 (2026-06-13): bake the prod hotfixes (yt-dlp wrapper +
# cookies chown) into the pipeline lifecycle so they survive future
# deploys. The leading `+` runs as root (drops to User=genlab for the
# main ExecStart). Idempotent + never blocks the pipeline.
ExecStartPre=+/opt/genlab/deploy/scripts/ensure_yt_dlp_environment.sh
ExecStart=/bin/bash /opt/genlab/BlackboxBrief/runbooks/cron_wrapper.sh
TimeoutSec=14400
