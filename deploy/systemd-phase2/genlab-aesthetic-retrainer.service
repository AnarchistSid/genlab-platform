[Unit]
Description=GenLab aesthetic model monthly retrainer — fits logreg on top-20/bottom-20 reward buckets
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=10min
ExecStart=/usr/local/bin/uv run python scripts/retrain_aesthetic_model.py
StandardOutput=journal
StandardError=journal

MemoryMax=1G
CPUWeight=25

[Install]
WantedBy=multi-user.target
