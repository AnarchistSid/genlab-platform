[Unit]
Description=GenLab Permissions Drift Detector (2026-06-16 outage prevention)
After=network-online.target postgresql.service

# Surface unit failures to the dashboard CriticalAlertsBanner
# (2026-06-16 outage prevention). Template unit lives at
# scripts/systemd_failure_alert.sh.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
ExecStart=/opt/genlab/scripts/check_permissions_drift.sh
TimeoutSec=120
# Exit 2 = drift found + alert written; treat as success for systemd
# purposes (the actual signal is the pipeline_alerts row, not the
# unit's exit status).
SuccessExitStatus=0 2
StandardOutput=append:/opt/genlab/.logs/check_permissions_drift.systemd.log
StandardError=append:/opt/genlab/.logs/check_permissions_drift.systemd.log
