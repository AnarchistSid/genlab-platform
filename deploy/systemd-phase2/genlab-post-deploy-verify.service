[Unit]
Description=GenLab Post-Deploy Verify — sanity-check prod after deploy/restart
After=genlab-dashboard.service postgresql.service

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/genlab
ExecStart=/opt/genlab/scripts/post_deploy_verify.sh
TimeoutSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
