[Unit]
Description=GenLab Strategist — weekly LLM-based meta-cognition per niche
After=network-online.target
Wants=network-online.target
# Surface unit failures to the dashboard CriticalAlertsBanner
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
# Strategist calls the LLM at most once per niche per week, so a
# generous timeout is fine — it's not going to hog resources.
# 2026-07-07 bump: 15min was insufficient at 5-niche prod runtime.
# Real-world runtime measured 00:01→00:16 UTC processing ai_creators
# + gaming, timeout hit during movies. Each niche takes ~5-10 min
# with Anthropic API retries (small backoff windows suggest transient
# API pressure, not hard failure). 45min budget = ~9min per niche
# with headroom for one bad retry cycle.
TimeoutStartSec=45min
# File-path invocation — see sibling ``genlab-late-reward.service``
# for the same fix. ``scripts/`` is not a Python package (no
# ``__init__.py``), so ``-m scripts.run_strategist`` fails at import
# time — caught by ``test_systemd_module_drift.py``.
ExecStart=/usr/local/bin/uv run python scripts/run_strategist.py
StandardOutput=journal
StandardError=journal

# Resource caps — Strategist is a Python + HTTP process, never
# renders video, so tight limits are safe.
MemoryMax=512M
CPUWeight=50

[Install]
WantedBy=multi-user.target
