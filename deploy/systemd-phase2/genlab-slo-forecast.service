[Unit]
Description=GenLab SLO forecaster — 24h-ahead breach projection
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=3min
ExecStart=/usr/local/bin/uv run python scripts/run_slo_forecast.py
StandardOutput=journal
StandardError=journal

MemoryMax=128M
CPUWeight=20

[Install]
WantedBy=multi-user.target
