{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlatformContent",
  "description": "Platform-native content generated by adapt_for_platforms.py",
  "definitions": {
    "YouTubeContent": {
      "type": "object",
      "required": ["platform", "publish_as"],
      "properties": {
        "platform": { "const": "youtube" },
        "publish_as": { "enum": ["community_post", "short_video"] },
        "community_post_text": { "type": "string", "maxLength": 1500 },
        "image_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "short_script": {
          "type": "object",
          "properties": {
            "voiceover": { "type": "string" },
            "title": { "type": "string", "maxLength": 70 },
            "description": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "TwitterContentSingle": {
      "type": "object",
      "required": ["platform", "routing", "tweet_text"],
      "properties": {
        "platform": { "const": "twitter" },
        "routing": { "const": "single" },
        "tweet_text": { "type": "string", "maxLength": 280 }
      }
    },
    "TwitterContentThread": {
      "type": "object",
      "required": ["platform", "routing", "thread_tweets"],
      "properties": {
        "platform": { "const": "twitter" },
        "routing": { "const": "thread" },
        "thread_tweets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "text"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "text": { "type": "string", "maxLength": 280 },
              "image_indices": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/YouTubeContent" },
    { "$ref": "#/definitions/TwitterContentSingle" },
    { "$ref": "#/definitions/TwitterContentThread" }
  ]
}
