[Unit]
Description=GenLab Strategist weekly cadence — Sunday 02:00 UTC
Documentation=file:///opt/genlab/docs/STRATEGIST-SPEC.md

[Timer]
# Sunday 02:00 UTC = 07:30 IST. Chosen so operator has the report
# waiting when they start Monday review. Wait until Sunday 02:00
# ensures the previous week's engagement data has settled (posts
# from Saturday have their 48h reward window still open, but the
# earlier days of the week are complete).
OnCalendar=Sun 02:00:00 UTC
# 2026-07-17: flipped Persistent=false → true. If the VPS is down or
# the service crashes on Sunday 02:00 UTC, missed fires now catch up
# on next boot. The strategist is weekly and the report drives Monday
# operator review — silently missing a week would be undetectable
# until the next Sunday. Deep-cuts audit surfaced this after a
# journal review showed no strategist runs since 2026-06-15.
Persistent=true
Unit=genlab-strategist.service

[Install]
WantedBy=timers.target
