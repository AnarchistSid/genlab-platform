[Unit]
Description=GenLab Meta-Strategist — weekly LLM grading of strategist proposal quality
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=10min
ExecStart=/usr/local/bin/uv run python scripts/run_meta_strategist.py
StandardOutput=journal
StandardError=journal

MemoryMax=384M
CPUWeight=25

[Install]
WantedBy=multi-user.target
