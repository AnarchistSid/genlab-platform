[Unit]
Description=GenLab Attribution Health Monitor — surface low attribution_present_pct as a CRITICAL alert
Documentation=https://github.com/AnarchistSid/genlab-platform/blob/main/genlab-core/src/genlab_core/monitoring/attribution_health_monitor.py
After=network-online.target postgresql.service
Wants=network-online.target
# 2026-07-14 audit fix: this monitor guards the audience-facing
# attribution invariant. Post-2026-07-14 with LAYER4_BLOCK=1, a
# broken monitor is HIGHER risk than a broken monitor pre-flip
# because: the monitor is the FIRST detector of any regression
# past L4 (which fails-open on unrecognized markers). If the
# monitor itself dies silently, we lose the tightest observable
# signal on attribution health. OnFailure fires the standard
# failure_alert path so systemd_unit_failed critical alerts write
# to pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
ExecStart=/opt/genlab/.venv/bin/python /opt/genlab/scripts/attribution_health_monitor.py
# Same contract as anthropic-credit-monitor — exit 0 always so a
# transient DB blip doesn't cascade into systemd_unit_failed noise
# on Mission Control's CRITICAL banner.
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
