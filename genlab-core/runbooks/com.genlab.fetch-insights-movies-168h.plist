<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genlab.fetch-insights-movies-168h</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/anarchistsid/GenLab/scripts/launch_wrapper.sh</string>
        <string>/Users/anarchistsid/.local/bin/uv</string>
        <string>run</string>
        <string>--package</string>
        <string>genlab-core</string>
        <string>python</string>
        <string>-m</string>
        <string>genlab_core.scripts.run_fetch_insights</string>
        <string>--niche-id</string>
        <string>movies</string>
        <string>--window</string>
        <string>168</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/anarchistsid/GenLab</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/anarchistsid/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/anarchistsid</string>
        <key>BACKLOG_CONFIG_PATH</key>
        <string>/Users/anarchistsid/GenLab/genlab-core/config/lists_config.yaml</string>
    </dict>

    <!-- 168h (7d) after publish → 20:24 UTC (staggered) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>24</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/fetch_insights_movies_168h.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/fetch_insights_movies_168h_error.log</string>

    <key>TimeOut</key>
    <integer>300</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
