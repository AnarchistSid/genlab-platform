[Unit]
Description=GenLab Cuelinks campaign shortlist refresh (weekly)
Documentation=file:///opt/genlab/scripts/refresh_cuelinks_campaigns.py
After=network-online.target

# 2026-07-14: mass OnFailure coverage — every genlab service should
# route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
# PR 2 of 3 (2026-07-16) — Cuelinks V3 API integration.
# Fetches merchant campaigns (open access only), sorts by 7-day EPC,
# writes a curated shortlist to genlab-core/config/cuelinks_campaigns.yaml.
# PR 3 will wire affiliate_matcher to consume this shortlist as a
# discovery source for high-EPC non-Amazon merchants.
#
# TimeoutSec generous because /campaigns is a single API call but the
# V3 API's response time is unknown in prod. 5min is well over the
# 10s per-request timeout in cuelinks_client.
ExecStart=/opt/genlab/.venv/bin/python /opt/genlab/scripts/refresh_cuelinks_campaigns.py
TimeoutSec=300
StandardOutput=journal
StandardError=journal

MemoryMax=128M
CPUWeight=20

[Install]
WantedBy=multi-user.target
