[Unit]
Description=GenLab Cuelinks V3 conversion importer → affiliate_revenue
Documentation=file:///opt/genlab/scripts/import_cuelinks_conversions.py
After=network-online.target

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
# Layer 2 batch 2 (2026-07-17) — Cuelinks V3 /conversions/list polling.
#
# Closes the "all revenue is fake" gap: prior state had 0 conversions
# ever tracked from any network (affiliate_revenue.conversions = 0 on
# every row; all revenue_amount was clicks × 0.02 estimation).
#
# Cuelinks V3 exposes /conversions polling — until this timer wired,
# we ignored it. Real conversion data unblocks:
#   1. RPM-per-post Mission Control card (real revenue / real views)
#   2. Product bandit training (currently 0 observations on 108 arms)
#   3. Per-blueprint revenue attribution (via subid → blueprint_id)
#
# Requires: CUELINKS_V3_API_KEY on prod .env (still pending operator
# provisioning as of ship). Without the key, list_conversions() returns
# [] gracefully (fail-open) — script exits 0 without inserting.
#
# Fetch window: last 2 days (catches late-confirmed conversions from
# earlier orders — Cuelinks confirms 24-72h after purchase).
ExecStart=/opt/genlab/.venv/bin/python scripts/import_cuelinks_conversions.py --apply --days-back 2
TimeoutSec=600

[Install]
WantedBy=multi-user.target
