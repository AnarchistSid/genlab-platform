[Unit]
Description=GenLab FB self-comment amplifier — post YT link as self-comment on high-reach FB posts
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
ExecStart=/usr/local/bin/uv run python scripts/run_fb_self_comment_amplifier.py
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=20

[Install]
WantedBy=multi-user.target
