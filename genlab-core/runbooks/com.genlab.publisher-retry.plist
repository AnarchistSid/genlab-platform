<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genlab.publisher-retry</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/anarchistsid/GenLab/scripts/launch_wrapper.sh</string>
        <string>/Users/anarchistsid/.local/bin/uv</string>
        <string>run</string>
        <string>--package</string>
        <string>genlab-core</string>
        <string>python</string>
        <string>-m</string>
        <string>genlab_core.publishing.publish_all_platforms</string>
        <string>--niche</string>
        <string>all</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/anarchistsid/GenLab</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/anarchistsid/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/anarchistsid</string>
    </dict>
    <!-- Retry window: 10:00 UTC = 15:30 IST (afternoon catch-up) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/publisher_retry.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/publisher_retry_error.log</string>
    <key>TimeOut</key>
    <integer>900</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
