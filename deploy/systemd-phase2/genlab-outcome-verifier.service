[Unit]
Description=GenLab Strategist outcome verifier — 48h post-apply metric check + auto-rollback
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
# File-path invocation — scripts/ is not a Python package.
ExecStart=/usr/local/bin/uv run python scripts/run_outcome_verifier.py
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=30

[Install]
WantedBy=multi-user.target
