<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/anarchistsid</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.genlab.db-maintenance</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/anarchistsid/GenLab/scripts/db_maintenance.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/anarchistsid/GenLab/.logs/db_maintenance_error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/anarchistsid/GenLab/.logs/db_maintenance.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>45</integer>
	</dict>
	<key>TimeOut</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>/Users/anarchistsid/GenLab</string>
</dict>
</plist>
