[Unit]
Description=GenLab Proxy Revenue Aggregator
After=network-online.target docker.service

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
# Aggregate yesterday's clicks into proxy revenue rows in
# affiliate_revenue. Idempotent: re-running for the same day
# DELETEs prior proxy rows then INSERTs fresh ones. Audit R-32.
ExecStart=/opt/genlab/.venv/bin/python -m genlab_core.monetization.proxy_revenue_aggregator
TimeoutSec=300

[Install]
WantedBy=multi-user.target
