<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genlab.ai-creators-publisher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/anarchistsid/GenLab/.venv/bin/python3</string>
        <string>-m</string>
        <string>genlab_core.publishing.publish_all_platforms</string>
        <string>--niche</string>
        <string>ai_creators</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/anarchistsid/GenLab</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/anarchistsid/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/anarchistsid</string>
        <key>BACKLOG_CONFIG_PATH</key>
        <string>/Users/anarchistsid/GenLab/genlab-core/config/lists_config.yaml</string>
    </dict>

    <!-- 06:30 UTC daily (12:00 IST) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/publisher_ai_creators.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/publisher_ai_creators_error.log</string>

    <key>TimeOut</key>
    <integer>600</integer>
</dict>
</plist>
