[Unit]
Description=GenLab Operations Dashboard
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=exec
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=BACKLOG_CONFIG_PATH=/opt/genlab/genlab-core/config/lists_config.yaml
Environment=GENLAB_USE_POSTGRES=true
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379
ExecStart=/opt/genlab/.venv/bin/gunicorn \
    --worker-class gthread \
    --workers 1 \
    --threads 4 \
    --timeout 120 \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --bind 127.0.0.1:5151 \
    --access-logfile /opt/genlab/.logs/dashboard_access.log \
    --error-logfile /opt/genlab/.logs/dashboard_error.log \
    --capture-output \
    server.review_server:app
# READINESS, not liveness. `systemctl is-active` reports the PROCESS; on
# 2026-09-19 gunicorn's master was active and listening on 5151 while its
# gthread worker lost a fork race and blocked in futex_wait before booting. The
# socket accepted connections and answered none of them for four hours, and
# every check said the service was up.
#
# ExecStartPost fails the start if nothing answers, so that shape pages in a
# minute. Restart=always then retries it, which is what clears a lost fork race.
ExecStartPost=/opt/genlab/deploy/systemd-phase2/lib/http_ready.sh http://127.0.0.1:5151/api/v1/compliance/stats 30
TimeoutStartSec=90

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
