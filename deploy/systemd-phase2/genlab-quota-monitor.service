[Unit]
Description=GenLab Disk Quota Monitor
After=network-online.target

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=exec
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
ExecStart=/opt/genlab/.venv/bin/python -m genlab_core.storage.quota_daemon \
    --config /opt/genlab/genlab-core/config/disk_quota.yaml \
    --interval 60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
