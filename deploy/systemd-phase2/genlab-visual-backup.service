[Unit]
Description=GenLab visual asset backup — daily rendered .mp4 snapshot
After=network-online.target
# Fire AFTER pg-backup so both DB + files land in the same daily window
After=genlab-pg-backup.service
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
# 2026-08-21: was User=root/Group=root. Running as root made mkdir -p create
# /opt/genlab/.backups/visuals/<date>/ and <date>/opt/ owned by root:root —
# everything deeper stayed genlab because cp -a preserves source ownership.
# The permissions-drift monitor then flagged 2 new root-owned paths EVERY DAY,
# and repair_permissions.sh only ever cleaned up after the fact.
#
# This is CLAUDE.md rule #15 (never leave root-owned paths in a tree that
# genlab-user services read/write). Nothing here needs root: the script is a
# hardlink farm from /opt/genlab/.tmp/runs/*/visuals/*.mp4 into
# /opt/genlab/.backups/visuals/, and genlab owns both ends.
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
# 14-day retention × ~50 MB/render × 5 renders/niche/day × 5 niches
# = ~17 GB steady state. Hardlink dedup keeps it much smaller in
# practice (unchanged files across days share bytes).
TimeoutStartSec=30min
ExecStart=/opt/genlab/scripts/backup_visual_assets.sh --apply
StandardOutput=journal
StandardError=journal

# Runs as root because /opt/genlab/.backups/ is root-owned + the S3 sync
# (when enabled) needs to be able to read the aws CLI cache which lives
# at /root/.aws/credentials on the box.
MemoryMax=256M
CPUWeight=30

[Install]
WantedBy=multi-user.target
