[Unit]
Description=GenLab 2026-07-22 fixes verification — post-morning-fire hook check
After=network-online.target genlab-publisher.service

# One-shot verification that the 4 deployed-but-unverified 2026-07-22
# fixes actually landed correctly under real traffic:
#
#   1. Movies writer summary-field 3-field precedence (544cf0e9) —
#      should produce >0 movies blueprints today.
#   2. Movies Threads dispatch (999e6b86 config + writer fix chain) —
#      first-ever movies Threads publish attempt.
#   3. Odyssey blueprint publish (scheduled_for 2026-07-23 06:30 UTC) —
#      status transitions to PUBLISHED / INSIGHTS_6H.
#   4. uuid5-seed fix (272f0825) — recent post_decision_trace rows
#      should have BOTH bandit_arm_id AND engagement_reach_24h populated
#      on the SAME row via ON CONFLICT merge.
#
# Also tracks whether the 5/5 Threads matrix closes for the first
# time in 30+ days.
#
# Rule #26 compliant: script exits 0 always (data-side signal, operator
# reads stdout / grep from journalctl). Add --strict via ExecStart if
# wiring into pipeline_alerts.

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=PGPASSWORD=genlab_dev
ExecStart=/opt/genlab/scripts/verify_2026_07_22_fixes_morning.sh
TimeoutSec=90

[Install]
WantedBy=multi-user.target
