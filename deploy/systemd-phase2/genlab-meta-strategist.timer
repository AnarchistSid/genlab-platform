[Unit]
Description=Fire GenLab meta-strategist Monday 09:00 UTC — reviews prior week's strategist proposals after outcome verifier has caught up
Requires=genlab-meta-strategist.service

[Timer]
OnCalendar=Mon *-*-* 09:00:00 UTC
Persistent=true
Unit=genlab-meta-strategist.service

[Install]
WantedBy=timers.target
