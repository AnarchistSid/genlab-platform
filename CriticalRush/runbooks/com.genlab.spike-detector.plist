<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genlab.spike-detector</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/anarchistsid/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/anarchistsid/GenLab/CriticalRush</string>
        <string>python</string>
        <string>-m</string>
        <string>niches.gaming.flows.spike_detector_flow</string>
        <string>--once</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/anarchistsid/GenLab/CriticalRush</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/spike-detector.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/spike-detector_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/anarchistsid</string>
    </dict>
</dict>
</plist>
