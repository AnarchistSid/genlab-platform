#!/bin/bash
# Daily Intel Run — Blackbox Brief v4.0
#
# 23-step pipeline organized in 9 phases:
#   Phase 1: Ingestion     (steps 1-3)   — Fetch, parse, extract media
#   Phase 2: Intelligence  (steps 4-7)   — Dedupe, rank, download videos, compose blueprints
#   Phase 3: Quality       (step 8)      — QC gates
#   Phase 4: Content       (steps 9-10)  — Hooks, outlines (local only)
#   Phase 5: Push & Sync   (steps 11-11b)— Backlog push (before SharePoint-dependent steps)
#   Phase 6: Post Writing  (steps 12-13) — Post copy + platform adaptation (queries SharePoint)
#   Phase 7: Review        (steps 14-15) — Virality scoring, human review
#   Phase 8: Rendering     (steps 16-18) — Visuals, overlays, audio
#   Phase 9: Publishing    (steps 19-20) — Validate, publish
#   Phase 10: Analytics    (steps 21-23) — Insights, run report, done
#
# Express lane (CRITICAL/HIGH urgency stories):
#   After parse, classify urgency → fast-track CRITICAL/HIGH stories through
#   the full pipeline: compose → content → adapt → render → auto-approve → publish-ready.
#   Target: <45 min (vs 2-4 hours for competitors).
#
# Usage:
#   Manual:  ./runbooks/daily_intel.sh
#   Cron:    0 8 * * * "$GENLAB_PROJECT_DIR/runbooks/daily_intel.sh"
#
# This script is cron-safe: uses absolute paths, activates venv, logs output.

set -euo pipefail

# ── Paths (absolute for cron safety) ──────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="${GENLAB_PROJECT_DIR:-${PROJECT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}}"
# Prefer uv workspace venv, fall back to local venv
_WORKSPACE_VENV="$(cd "$PROJECT_DIR/.." && pwd)/.venv/bin/python3"
_LOCAL_VENV="$PROJECT_DIR/venv/bin/python3"
if [ -z "${VENV_PYTHON:-}" ]; then
    if [ -x "$_WORKSPACE_VENV" ]; then
        VENV_PYTHON="$_WORKSPACE_VENV"
    else
        VENV_PYTHON="$_LOCAL_VENV"
    fi
fi
LOG_DIR="$PROJECT_DIR/.tmp/logs"

# ── Setup ─────────────────────────────────────────────────────
cd "$PROJECT_DIR"
mkdir -p "$LOG_DIR"

# ── Concurrency lock (prevent overlapping runs) ──────────────
# Uses mkdir-based lock (portable to macOS — flock is Linux-only)
LOCK_DIR="$PROJECT_DIR/.tmp/.daily_intel.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    # Check if the locking PID is still alive (stale lock recovery)
    if [ -f "$LOCK_DIR/pid" ]; then
        LOCK_PID=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
        if [ -n "$LOCK_PID" ] && ! kill -0 "$LOCK_PID" 2>/dev/null; then
            echo "WARNING: Removing stale lock from dead PID $LOCK_PID"
            rm -rf "$LOCK_DIR"
            mkdir "$LOCK_DIR" 2>/dev/null || { echo "ERROR: Could not acquire lock"; exit 1; }
        else
            echo "ERROR: Another daily_intel.sh instance is already running (PID: ${LOCK_PID:-unknown}, lock: $LOCK_DIR)"
            echo "  If you're sure no other instance is running, remove the lock: rm -rf $LOCK_DIR"
            exit 1
        fi
    else
        echo "ERROR: Lock directory exists but no PID file. Remove manually: rm -rf $LOCK_DIR"
        exit 1
    fi
fi
echo $$ > "$LOCK_DIR/pid"

# ── Cleanup trap (release lock + report on abort) ────────────
cleanup_on_exit() {
    local exit_code=$?
    if [ "$exit_code" -ne 0 ] && [ "$exit_code" -ne 1 ]; then
        echo ""
        echo "  Pipeline aborted (exit code: $exit_code)"
        echo "  Partial artifacts may exist in .tmp/runs/${RUN_ID:-unknown}/"
        echo "  Aborted at: $(date)"
    fi
    rm -rf "$LOCK_DIR" 2>/dev/null || true
}
trap cleanup_on_exit EXIT

# Express review mode: "stream" (CLI) or "web" (browser dashboard on :5151)
EXPRESS_REVIEW_MODE="${EXPRESS_REVIEW_MODE:-stream}"

# Creator-focused throughput defaults (overridable via env).
TREND_PACK_TOP_N="${TREND_PACK_TOP_N:-250}"
TREND_PACK_CLUSTER_MODE="${TREND_PACK_CLUSTER_MODE:-all}"
# Express lane render stages are expensive and duplicate standard steps.
# Set to 1 to keep full express render/publish behavior.
EXPRESS_RENDER_NOW="${EXPRESS_RENDER_NOW:-0}"
# Overlay audio policy: "original" preserves source clip audio (default),
# "synthetic" generates/replaces with TTS + music.
RENDER_AUDIO_MODE="${RENDER_AUDIO_MODE:-original}"

# Post-run cleanup policy (artifact retention + optional cache wipes).
CLEANUP_AFTER_RUN="${CLEANUP_AFTER_RUN:-1}"
CLEANUP_KEEP_RUNS="${CLEANUP_KEEP_RUNS:-3}"
CLEANUP_KEEP_LOGS="${CLEANUP_KEEP_LOGS:-50}"
CLEANUP_WIPE_MEDIA_CACHE="${CLEANUP_WIPE_MEDIA_CACHE:-0}"
CLEANUP_WIPE_AUDIO_CACHE="${CLEANUP_WIPE_AUDIO_CACHE:-0}"
CLEANUP_WIPE_FETCH_CACHE="${CLEANUP_WIPE_FETCH_CACHE:-0}"

# Source .env for env vars used in shell (e.g. SHAREPOINT_SITE_ID for status link)
if [ -f "$PROJECT_DIR/.env" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            var_name="${line%%=*}"
            var_value="${line#*=}"
            # Strip surrounding single or double quotes
            var_value="${var_value#\'}" ; var_value="${var_value%\'}"
            var_value="${var_value#\"}" ; var_value="${var_value%\"}"
            export "$var_name=$var_value"
        fi
    done < "$PROJECT_DIR/.env"
fi

# Use nanosecond-precision timestamp to avoid collision risk with 1-second granularity.
# macOS date doesn't support %N — fall back to seconds + PID.
RUN_ID=$(date +%Y%m%d_%H%M%S)_$$
PIPELINE_START=$(date +%s)
LOG_FILE="$LOG_DIR/run_${RUN_ID}.log"

# Log to both file and stdout
exec > >(tee -a "$LOG_FILE") 2>&1

echo "========================================="
echo "Blackbox Brief — Daily Intel Pipeline v4.0"
echo "Run ID: $RUN_ID"
echo "Started: $(date)"
echo "========================================="
echo ""

# ── Step runner with timing ───────────────────────────────────
STEP_FAILURES=0
STEP_TIMINGS=""

# Structured timing JSON — written after each step for crash-safe recording
TIMING_FILE="$PROJECT_DIR/.tmp/runs/$RUN_ID/pipeline_timing.json"
mkdir -p "$PROJECT_DIR/.tmp/runs/$RUN_ID"

# Initialize timing JSON
cat > "$TIMING_FILE" <<TIMEOF
{
  "run_id": "$RUN_ID",
  "pipeline_version": "4.0",
  "pipeline_start": $(date +%s),
  "pipeline_start_iso": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "steps": [],
  "express": null
}
TIMEOF

# Append a step timing entry to the JSON file
record_step_timing() {
    local step_num="$1"
    local label="$2"
    local elapsed="$3"
    local status="$4"  # "ok" or "failed"

    "$VENV_PYTHON" -c "
import json, sys
with open('$TIMING_FILE') as f:
    data = json.load(f)
data['steps'].append({
    'step': '$step_num',
    'label': '$label',
    'elapsed_seconds': $elapsed,
    'status': '$status',
    'timestamp': $(date +%s)
})
with open('$TIMING_FILE', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true
}

run_command_capture_exit() {
    # Capture exit codes safely under set -e without suppressing failures.
    local __exit_var="$1"
    shift
    local _exit_code=0
    if "$@"; then
        _exit_code=0
    else
        _exit_code=$?
    fi
    printf -v "$__exit_var" '%s' "$_exit_code"
}

run_step() {
    local step_num="$1"
    local label="$2"
    local fatal="${3:-true}"  # "true" = fatal, "false" = non-fatal
    shift 3
    local cmd=("$@")

    echo "[${step_num}/23] ${label}..."
    local step_start
    step_start=$(date +%s)

    local _rc=0
    if "${cmd[@]}"; then
        _rc=0
    else
        _rc=$?
    fi

    local elapsed=$(( $(date +%s) - step_start ))

    if [ "$_rc" -eq 0 ]; then
        if [ "$elapsed" -gt 300 ]; then
            echo "  ✓ ${label} (${elapsed}s) ⚠️ SLOW (>5min)"
        else
            echo "  ✓ ${label} (${elapsed}s)"
        fi
        STEP_TIMINGS="${STEP_TIMINGS}  [${step_num}/23] ${label}: ${elapsed}s\n"
        record_step_timing "$step_num" "$label" "$elapsed" "ok"
    elif [ "$_rc" -eq 2 ]; then
        # Exit code 2 = "nothing to do" — not a failure, just skipped
        echo "  ○ ${label} skipped — nothing to do (${elapsed}s)"
        STEP_TIMINGS="${STEP_TIMINGS}  [${step_num}/23] ${label}: SKIPPED (${elapsed}s)\n"
        record_step_timing "$step_num" "$label" "$elapsed" "skipped"
    else
        STEP_FAILURES=$(( STEP_FAILURES + 1 ))
        STEP_TIMINGS="${STEP_TIMINGS}  [${step_num}/23] ${label}: FAILED (${elapsed}s)\n"
        record_step_timing "$step_num" "$label" "$elapsed" "failed"
        if [ "$fatal" = "true" ]; then
            echo "  ❌ ${label} failed (fatal — aborting)"
            exit 1
        else
            echo "  ⚠️  ${label} failed (non-fatal)"
        fi
    fi
    echo ""
}

# ══════════════════════════════════════════════════════════════
# PRE-FLIGHT CHECKS
# ══════════════════════════════════════════════════════════════

echo "[0a] Setup validation..."
# validate_setup.py was archived in Sprint 66 — token health check covers its role
echo "  ✓ Setup check passed (delegated to token health)"

echo "[0b] Checking API tokens & credentials..."
if ! "$VENV_PYTHON" execution/check_token_health.py 2>&1 | grep -E '(✅|🔄|⚠️|❌|💸|Summary)'; then
    echo "  ⚠️  Some API tokens are unhealthy — pipeline will proceed but publishing may fail"
fi
echo ""

echo "[0c] Backing up Microsoft Lists..."
# backup_lists.py requires azure module (SharePoint legacy) — skip if unavailable
if "$VENV_PYTHON" execution/backup_lists.py --keep-last 7 2>&1 | tee -a "$LOG_FILE"; then
    echo "  ✓ Backup complete"
else
    echo "  ⚠️  Backup skipped (SharePoint legacy — data is in PostgreSQL)"
fi
echo ""

echo "[0d] Preflight record count check..."
# preflight_check.py requires azure module — skip gracefully since PostgreSQL is primary
if "$VENV_PYTHON" execution/preflight_check.py --threshold 0.20 2>&1 | tee -a "$LOG_FILE"; then
    echo "  ✓ Preflight passed"
else
    echo "  ⚠️  Preflight check unavailable (SharePoint legacy) — continuing with PostgreSQL"
fi
echo ""

# ══════════════════════════════════════════════════════════════
# EXPRESS LANE (CRITICAL/HIGH urgency stories)
# ══════════════════════════════════════════════════════════════

# Fetch + parse first (needed for urgency classification)
run_step "E1" "Express: fetching AI news"      true  "$VENV_PYTHON" execution/fetch_ai_creators.py --run-id "$RUN_ID"
run_step "E2" "Express: parsing content"        true  "$VENV_PYTHON" execution/parse_extract.py --run-id "$RUN_ID"
run_step "E3" "Express: extracting media"       true  "$VENV_PYTHON" execution/extract_media.py --run-id "$RUN_ID" --skip-if-present

EXPRESS_COUNT=0
EXPRESS_START=$(date +%s)
run_step "E4" "Classifying urgency"             false "$VENV_PYTHON" execution/classify_urgency.py --run-id "$RUN_ID"

# Check if express candidates exist
EXPRESS_FILE="$PROJECT_DIR/.tmp/runs/$RUN_ID/express_candidates.json"
if [ -f "$EXPRESS_FILE" ]; then
    EXPRESS_COUNT=$("$VENV_PYTHON" -c "import json; d=json.load(open('$EXPRESS_FILE')); print(len(d.get('express_stories',[])))" 2>/dev/null || echo 0)
fi

if [ "$EXPRESS_COUNT" -gt 0 ]; then
    EXPRESS_TP="$PROJECT_DIR/.tmp/runs/$RUN_ID/express_trend_pack.json"
    TREND_PACK_PATH="$PROJECT_DIR/.tmp/runs/$RUN_ID/trend_pack.json"
    echo ""
    echo "  ⚡ EXPRESS LANE: $EXPRESS_COUNT urgent stories detected!"
    echo "  Full pipeline: compose → content → adapt → render → publish"
    echo ""

    if [ -f "$EXPRESS_TP" ]; then
        cp "$EXPRESS_TP" "$TREND_PACK_PATH"
    fi

    run_step "E4b" "Express: downloading videos" false "$VENV_PYTHON" -m genlab_core.media.download_top_videos --run-id "$RUN_ID" --niche "${NICHE_ID:-ai_creators}" --max-stories 5 --project-dir "$PROJECT_DIR"
    run_step "E5" "Express: composing blueprints"  false "$VENV_PYTHON" execution/compose_blueprints.py --trend-pack "$EXPRESS_TP" --run-id "$RUN_ID"
    run_step "E6" "Express: generating content"    false "$VENV_PYTHON" execution/generate_content.py --run-id "$RUN_ID"
    run_step "E7" "Express: running QC gates"      false "$VENV_PYTHON" execution/run_qc_gates.py --run-id "$RUN_ID"
    run_step "E8" "Express: pushing to backlog"    false "$VENV_PYTHON" execution/push_to_backlog.py --run-id "$RUN_ID" --type stories
    "$VENV_PYTHON" execution/push_to_backlog.py --run-id "$RUN_ID" --type blueprints 2>&1 || true
    run_step "E9" "Express: writing post content"  false "$VENV_PYTHON" execution/write_post_content.py --run-id "$RUN_ID" --limit 4
    run_step "E10" "Express: platform adaptation"  false "$VENV_PYTHON" execution/adapt_for_platforms.py --run-id "$RUN_ID"

    if [ "$EXPRESS_RENDER_NOW" = "1" ]; then
        run_step "E11" "Express: extracting media"     false "$VENV_PYTHON" execution/extract_media.py --run-id "$RUN_ID" --skip-if-present
        run_step "E12" "Express: clipping videos"      false "$VENV_PYTHON" execution/clip_video.py --run-id "$RUN_ID"
        run_step "E13" "Express: rendering overlays"   false "$VENV_PYTHON" execution/render_text_overlays.py --run-id "$RUN_ID" --audio-mode "$RENDER_AUDIO_MODE"
        run_step "E14" "Express: validating videos"    false "$VENV_PYTHON" execution/validate_videos.py --run-id "$RUN_ID" --fix
        run_step "E15" "Express: auto-approving"       false "$VENV_PYTHON" execution/prepare_for_review.py --run-id "$RUN_ID" --auto-approve
        run_step "E16" "Express: finalizing"           false "$VENV_PYTHON" execution/process_review.py --run-id "$RUN_ID"
    else
        echo "  ⏭️  Express render/publish deferred (EXPRESS_RENDER_NOW=0); standard pipeline will handle."
        echo ""
    fi

    EXPRESS_ELAPSED=$(( $(date +%s) - EXPRESS_START ))
    EXPRESS_MINS=$(( EXPRESS_ELAPSED / 60 ))
    EXPRESS_SECS=$(( EXPRESS_ELAPSED % 60 ))
    echo ""
    echo "  ⚡ EXPRESS LANE COMPLETE"
    echo "    Stories:  $EXPRESS_COUNT fast-tracked"
    echo "    Duration: ${EXPRESS_MINS}m ${EXPRESS_SECS}s"
    echo "    Target:   <45 min"
    if [ "$EXPRESS_ELAPSED" -le 2700 ]; then
        echo "    Status:   ✅ Under 45-minute target"
    else
        echo "    Status:   ⚠️  Over 45-minute target (${EXPRESS_MINS}m)"
    fi
    echo ""

    "$VENV_PYTHON" -c "
import json
with open('$TIMING_FILE') as f:
    data = json.load(f)
data['express'] = {
    'count': $EXPRESS_COUNT,
    'start': $EXPRESS_START,
    'elapsed_seconds': $EXPRESS_ELAPSED,
    'target_seconds': 2700,
    'under_target': True if $EXPRESS_ELAPSED <= 2700 else False
}
with open('$TIMING_FILE', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true
fi

# ══════════════════════════════════════════════════════════════
# STANDARD 23-STEP PIPELINE
# ══════════════════════════════════════════════════════════════

# ── Phase 1: Ingestion ───────────────────────────────────────
run_step 1  "Fetching AI news"                            true  "$VENV_PYTHON" execution/fetch_ai_creators.py --run-id "$RUN_ID"
run_step 2  "Parsing and extracting content"              true  "$VENV_PYTHON" execution/parse_extract.py --run-id "$RUN_ID"
run_step 3  "Extracting media (with Pexels fallback)"     false "$VENV_PYTHON" execution/extract_media.py --run-id "$RUN_ID" --skip-if-present

# ── Phase 2: Intelligence ────────────────────────────────────
run_step 4  "Deduplication and ranking"                   true  "$VENV_PYTHON" execution/dedupe_rank_items.py --run-id "$RUN_ID"
run_step 5  "Building trend pack"                         true  "$VENV_PYTHON" execution/build_trend_pack.py --run-id "$RUN_ID" --top-n "$TREND_PACK_TOP_N" --cluster-mode "$TREND_PACK_CLUSTER_MODE"
run_step 6  "Downloading videos for top stories"            false "$VENV_PYTHON" -m genlab_core.media.download_top_videos --run-id "$RUN_ID" --niche "${NICHE_ID:-ai_creators}" --max-stories 10 --project-dir "$PROJECT_DIR"
run_step 7  "Composing blueprints (platform hints + virality scoring)" true "$VENV_PYTHON" execution/compose_blueprints.py --run-id "$RUN_ID"

# ── Phase 3: Quality ─────────────────────────────────────────
echo "[8/23] Running QC gates..."
STEP_8_START=$(date +%s)
QC_EXIT=0
run_command_capture_exit QC_EXIT "$VENV_PYTHON" execution/run_qc_gates.py --run-id "$RUN_ID"
STEP_8_ELAPSED=$(( $(date +%s) - STEP_8_START ))
if [ "$QC_EXIT" -eq 2 ]; then
    echo "  ○ QC gates skipped — nothing to do (${STEP_8_ELAPSED}s)"
    STEP_TIMINGS="${STEP_TIMINGS}  [8/23] QC gates: SKIPPED (${STEP_8_ELAPSED}s)\n"
    record_step_timing "8" "Running QC gates" "$STEP_8_ELAPSED" "skipped"
elif [ "$QC_EXIT" -ne 0 ]; then
    echo "  ⚠️  QC pass rate below threshold (non-fatal)"
    STEP_FAILURES=$(( STEP_FAILURES + 1 ))
    STEP_TIMINGS="${STEP_TIMINGS}  [8/23] QC gates: WARNING (${STEP_8_ELAPSED}s)\n"
    record_step_timing "8" "Running QC gates" "$STEP_8_ELAPSED" "failed"
else
    echo "  ✓ QC gates passed (${STEP_8_ELAPSED}s)"
    STEP_TIMINGS="${STEP_TIMINGS}  [8/23] QC gates: ${STEP_8_ELAPSED}s\n"
    record_step_timing "8" "Running QC gates" "$STEP_8_ELAPSED" "ok"
fi
echo ""

# ── Phase 4: Content Preparation (local only) ────────────────
run_step 9  "Generating hooks"                            false "$VENV_PYTHON" execution/generate_hooks.py --run-id "$RUN_ID"
run_step 10 "Generating content outlines"                 true  "$VENV_PYTHON" execution/generate_content.py --run-id "$RUN_ID"

# ── Phase 5: Push & Sync (before SharePoint-dependent steps) ─
# IMPORTANT: Push must happen BEFORE write_post_content + adapt_for_platforms,
# which query SharePoint for INTEL_READY/DRAFTED blueprints.
echo "[11/23] Pushing to backlog..."
STEP_11_START=$(date +%s)
PUSH_LOCAL_ONLY=false
for PUSH_TYPE in stories blueprints assets; do
    PUSH_EXIT=0
    run_command_capture_exit PUSH_EXIT "$VENV_PYTHON" execution/push_to_backlog.py --run-id "$RUN_ID" --type "$PUSH_TYPE"
    if [ "$PUSH_EXIT" -eq 2 ]; then
        PUSH_LOCAL_ONLY=true
        echo "  ⚠️  Backlog unreachable — $PUSH_TYPE saved locally only"
        break
    elif [ "$PUSH_EXIT" -ne 0 ]; then
        echo "  ❌ Push failed for $PUSH_TYPE (exit code $PUSH_EXIT)"
        exit 1
    fi
done
STEP_11_ELAPSED=$(( $(date +%s) - STEP_11_START ))
if [ "$PUSH_LOCAL_ONLY" = true ]; then
    echo "  ⚠️  WARNING: Data did NOT reach backlog this run."
    STEP_TIMINGS="${STEP_TIMINGS}  [11/23] Pushing to backlog: ${STEP_11_ELAPSED}s (LOCAL ONLY)\n"
    STEP_FAILURES=$(( STEP_FAILURES + 1 ))
    record_step_timing "11" "Pushing to backlog" "$STEP_11_ELAPSED" "failed"
else
    echo "  ✓ Pushing to backlog (${STEP_11_ELAPSED}s)"
    STEP_TIMINGS="${STEP_TIMINGS}  [11/23] Pushing to backlog: ${STEP_11_ELAPSED}s\n"
    record_step_timing "11" "Pushing to backlog" "$STEP_11_ELAPSED" "ok"
fi
echo ""

# Source sync — populate/update Sources table from config
run_step "11b" "Syncing sources to backlog"               false "$VENV_PYTHON" execution/sync_sources.py --run-id "$RUN_ID"

# ── Phase 6: Post Writing + Platform Adaptation ──────────────
# These steps query SharePoint — blueprints must already be pushed.
run_step 12 "Writing post content (LLM, with affiliate awareness)" false "$VENV_PYTHON" execution/write_post_content.py --run-id "$RUN_ID" --limit 10
run_step 13 "Adapting for platforms (algorithm-aware + affiliate links)" false "$VENV_PYTHON" execution/adapt_for_platforms.py --run-id "$RUN_ID"

# ── Phase 7: Review ──────────────────────────────────────────
run_step 14 "Scoring virality predictions"                false "$VENV_PYTHON" execution/virality_scorer.py --run-id "$RUN_ID" --score-all

echo "[15/23] Waiting for human review..."
echo "        Dashboard: https://review.aspirehub.ai"
echo ""

# ── Phase 8: Visual Rendering (dual-path) ────────────────────
run_step 16 "Rendering visuals (custom + quick paths)"    false "$VENV_PYTHON" execution/render_visuals.py --run-id "$RUN_ID"
run_step 17 "Rendering text overlays"                     false "$VENV_PYTHON" execution/render_text_overlays.py --run-id "$RUN_ID" --audio-mode "$RENDER_AUDIO_MODE"
run_step 18 "Generating audio"                            false "$VENV_PYTHON" execution/generate_audio.py --run-id "$RUN_ID"

# ── Phase 9: Publishing ──────────────────────────────────────
echo "[19/23] Validating videos..."
STEP_19_START=$(date +%s)
VALIDATION_REPORT="$PROJECT_DIR/.tmp/runs/$RUN_ID/video_validation.json"

if "$VENV_PYTHON" execution/validate_videos.py --run-id "$RUN_ID" --fix; then
    STEP_19_ELAPSED=$(( $(date +%s) - STEP_19_START ))
    if [ -f "$VALIDATION_REPORT" ]; then
        VALID_PASSED=$("$VENV_PYTHON" -c "import json; d=json.load(open('$VALIDATION_REPORT')); print(d.get('passed',0))" 2>/dev/null || echo "?")
        VALID_TOTAL=$("$VENV_PYTHON" -c "import json; d=json.load(open('$VALIDATION_REPORT')); print(d.get('total',0))" 2>/dev/null || echo "?")
        VALID_FIXED=$("$VENV_PYTHON" -c "import json; d=json.load(open('$VALIDATION_REPORT')); print(d.get('fixed',0))" 2>/dev/null || echo "0")
        VALID_FAILED=$("$VENV_PYTHON" -c "import json; d=json.load(open('$VALIDATION_REPORT')); print(d.get('failed',0))" 2>/dev/null || echo "0")
        echo "  ✓ Video validation: ${VALID_PASSED}/${VALID_TOTAL} passed, ${VALID_FIXED} auto-fixed, ${VALID_FAILED} failed (${STEP_19_ELAPSED}s)"
    else
        echo "  ✓ Video validation completed (${STEP_19_ELAPSED}s)"
    fi
    STEP_TIMINGS="${STEP_TIMINGS}  [19/23] Validate videos: ${STEP_19_ELAPSED}s\n"
    record_step_timing "19" "Validating videos" "$STEP_19_ELAPSED" "ok"
else
    STEP_19_ELAPSED=$(( $(date +%s) - STEP_19_START ))
    STEP_FAILURES=$(( STEP_FAILURES + 1 ))
    if [ -f "$VALIDATION_REPORT" ]; then
        VALID_FAILED=$("$VENV_PYTHON" -c "import json; d=json.load(open('$VALIDATION_REPORT')); print(d.get('failed',0))" 2>/dev/null || echo "?")
        VALID_FIXFAIL=$("$VENV_PYTHON" -c "import json; d=json.load(open('$VALIDATION_REPORT')); print(d.get('fix_failures',0))" 2>/dev/null || echo "?")
        echo "  ⚠️  Video validation: ${VALID_FAILED} failed, ${VALID_FIXFAIL} unfixable (non-fatal, ${STEP_19_ELAPSED}s)"
    else
        echo "  ⚠️  Video validation failed (non-fatal, ${STEP_19_ELAPSED}s)"
    fi
    STEP_TIMINGS="${STEP_TIMINGS}  [19/23] Validate videos: PARTIAL (${STEP_19_ELAPSED}s)\n"
    record_step_timing "19" "Validating videos" "$STEP_19_ELAPSED" "failed"
fi
echo ""

run_step 20 "Publishing to all platforms"                 false "$VENV_PYTHON" execution/publish_all_platforms.py --run-id "$RUN_ID" --niche "${NICHE_ID:-ai_creators}"

# ── Phase 10: Analytics & Learning ───────────────────────────
run_step 21 "Fetching insights (with virality scoring)"   false "$VENV_PYTHON" execution/fetch_insights.py --run-id "$RUN_ID"
run_step 22 "Audience metrics snapshot"                   false "$VENV_PYTHON" execution/fetch_audience_metrics.py
run_step 23 "Writing run report"                          false "$VENV_PYTHON" execution/write_run_report.py --run-id "$RUN_ID"

echo "Run complete!"
echo ""

# ── Finalize pipeline timing JSON ─────────────────────────────
PIPELINE_ELAPSED=$(( $(date +%s) - PIPELINE_START ))
PIPELINE_MINS=$(( PIPELINE_ELAPSED / 60 ))
PIPELINE_SECS=$(( PIPELINE_ELAPSED % 60 ))

"$VENV_PYTHON" -c "
import json
with open('$TIMING_FILE') as f:
    data = json.load(f)
data['pipeline_end'] = $(date +%s)
data['pipeline_end_iso'] = '$(date -u +%Y-%m-%dT%H:%M:%SZ)'
data['pipeline_elapsed_seconds'] = $PIPELINE_ELAPSED
data['step_failures'] = $STEP_FAILURES
# Compute phase breakdowns
steps = data.get('steps', [])
phases = {
    'ingestion': {'range': (1, 3), 'steps': [], 'total': 0},
    'intelligence': {'range': (4, 7), 'steps': [], 'total': 0},
    'quality': {'range': (8, 8), 'steps': [], 'total': 0},
    'content_prep': {'range': (9, 10), 'steps': [], 'total': 0},
    'push_sync': {'range': (11, 11), 'steps': [], 'total': 0},
    'post_writing': {'range': (12, 13), 'steps': [], 'total': 0},
    'review': {'range': (14, 15), 'steps': [], 'total': 0},
    'rendering': {'range': (16, 18), 'steps': [], 'total': 0},
    'publishing': {'range': (19, 20), 'steps': [], 'total': 0},
    'analytics': {'range': (21, 23), 'steps': [], 'total': 0},
}
for s in steps:
    sn = str(s.get('step', ''))
    if sn.startswith('E') or sn.endswith('b'):
        continue  # Express / sub-steps tracked separately
    try:
        n = int(sn)
    except ValueError:
        continue
    for phase_name, phase_info in phases.items():
        lo, hi = phase_info['range']
        if lo <= n <= hi:
            phase_info['steps'].append(sn)
            phase_info['total'] += s.get('elapsed_seconds', 0)
            break
data['phase_breakdown'] = {
    k: {'steps': v['steps'], 'elapsed_seconds': v['total']}
    for k, v in phases.items()
}
with open('$TIMING_FILE', 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true

# ── Summary ──────────────────────────────────────────────────

echo "========================================="
if [ "$STEP_FAILURES" -eq 0 ]; then
    echo "  ✅ Run complete: $RUN_ID"
else
    echo "  ⚠️  Run complete with $STEP_FAILURES non-fatal failure(s): $RUN_ID"
fi
echo "  Duration: ${PIPELINE_MINS}m ${PIPELINE_SECS}s"
if [ "$EXPRESS_COUNT" -gt 0 ]; then
    echo "  Express: $EXPRESS_COUNT stories fast-tracked"
fi
echo "  Finished: $(date)"
echo "  Log: $LOG_FILE"
echo "  Report: .tmp/runs/$RUN_ID/run_report.json"
echo ""
echo "  Step timings:"
echo -e "$STEP_TIMINGS"

# SLO check: total pipeline should complete within 40 minutes (2400s)
SLO_TARGET_SECONDS=2400
if [ "$PIPELINE_ELAPSED" -gt "$SLO_TARGET_SECONDS" ]; then
    SLO_RATIO=$(( PIPELINE_ELAPSED / 60 ))
    echo "  ⚠️  SLO VIOLATION: Pipeline took ${SLO_RATIO}m (target: 40m)"
    echo "  Check per-step timings above to identify bottleneck."
    echo "  Known bottlenecks: render_visuals.py (sequential), generate_audio.py"
fi
echo "========================================="

# Show dashboard link
if [ -n "${SHAREPOINT_SITE_ID:-}" ]; then
    echo "  View: https://review.aspirehub.ai (dashboard)"
fi

# ── Cleanup (retention-based artifact hygiene) ────────────────
if [ "$CLEANUP_AFTER_RUN" = "1" ]; then
    CLEANUP_CMD=(
        "$VENV_PYTHON"
        execution/cleanup_artifacts.py
        --project-root "$PROJECT_DIR"
        --keep-runs "$CLEANUP_KEEP_RUNS"
        --keep-run-id "$RUN_ID"
        --keep-logs "$CLEANUP_KEEP_LOGS"
    )
    if [ "$CLEANUP_WIPE_MEDIA_CACHE" = "1" ]; then
        CLEANUP_CMD+=(--wipe-media-cache)
    fi
    if [ "$CLEANUP_WIPE_AUDIO_CACHE" = "1" ]; then
        CLEANUP_CMD+=(--wipe-audio-cache)
    fi
    if [ "$CLEANUP_WIPE_FETCH_CACHE" = "1" ]; then
        CLEANUP_CMD+=(--wipe-fetch-cache)
    fi

    # Always clean rendered media for published posts to reclaim disk space
    CLEANUP_CMD+=(--clean-published-media)

    CLEANUP_EXIT=0
    run_command_capture_exit CLEANUP_EXIT "${CLEANUP_CMD[@]}"
    if [ "$CLEANUP_EXIT" -ne 0 ]; then
        echo "  ⚠️  Cleanup step failed (non-fatal, exit $CLEANUP_EXIT)"
    fi
fi
