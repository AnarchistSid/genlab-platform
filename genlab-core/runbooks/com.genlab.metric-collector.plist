<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genlab.metric-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/anarchistsid/.local/bin/uv</string>
        <string>run</string>
        <string>--package</string>
        <string>genlab-core</string>
        <string>python</string>
        <string>-m</string>
        <string>genlab_core.learning.metric_collector</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/anarchistsid/GenLab/Content Scraper</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/anarchistsid/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/anarchistsid</string>
    </dict>

    <!-- Run every 60 minutes -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/anarchistsid/GenLab/Content Scraper/.tmp/logs/metric_collector.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anarchistsid/GenLab/Content Scraper/.tmp/logs/metric_collector_error.log</string>

    <key>TimeOut</key>
    <integer>600</integer>
</dict>
</plist>
