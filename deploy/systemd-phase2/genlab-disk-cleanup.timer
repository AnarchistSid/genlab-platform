[Unit]
Description=GenLab Disk Cleanup Timer — prune caches + old artifacts hourly

[Timer]
# 2026-07-01: tightened from 4x/day → HOURLY after a second-in-one-day
# 100%-disk crash. Cause: self-hosted CI runner + high-velocity commit
# window (10+ pushes in ~2 hours) → gh-runner .cache accumulated 11 GB
# faster than the 6h cleanup could catch. Hourly cadence covers even
# heavy-CI days without leaving the disk unprotected for hours at a
# time.
#
# The docker prune inside disk_cleanup.sh is idempotent + fast when
# there's nothing to reclaim (~50ms). apt/journal steps skip when
# they were already run recently. Net cost of the hourly cadence:
# negligible IOPS in steady state, aggressive when needed.
#
# Off-the-hour offset (:17) prevents pile-up with hourly
# metric_collector (00:00) + other production cadences.
OnCalendar=*-*-* *:17:00 UTC
# Catch-up after reboot. The cleanup is idempotent — running 4
# windows back-to-back after a long downtime just reclaims what was
# accumulating during the downtime.
Persistent=true

[Install]
WantedBy=timers.target
