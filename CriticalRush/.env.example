# CriticalRush — environment variables
# Copy this file and fill in real values before running the pipeline.
# Never commit this file to git.
#
# NOTE: Platform credentials (Meta, YouTube, X, TikTok, Threads) are
# shared across ALL agents. See /GenLab/.env.example for the canonical
# list. This file should contain ONLY niche-specific values (IGDB
# credentials, scoring weights, AGENT_ROOT, etc.).

# ── Agent root (required) ────────────────────────────────────
# Set to the absolute path of the CriticalRush directory, e.g.:
# AGENT_ROOT=/path/to/GenLab/CriticalRush
AGENT_ROOT=

# ── Anthropic (content writing) ──────────────────────────────
ANTHROPIC_API_KEY=

# ── Microsoft Graph / SharePoint (backlog storage) ───────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# ── Twitch / IGDB (clip sourcing + trending detection) ───────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Meta / Instagram ─────────────────────────────────────────
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_APP_ID=
META_IG_APP_SECRET=

# ── Meta / Facebook ──────────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
META_FB_PAGE_ID=

# ── YouTube ──────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── X / Twitter ──────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ── Threads (Meta Threads API v1) ──────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_ISSUED_AT=

# ── TikTok (Content Posting API v2) ────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_ISSUED_AT=
TIKTOK_AUDIT_APPROVED=false

# ── Pexels (clip sourcing fallback) ──────────────────────────
PEXELS_API_KEY=

# ── short-video-maker (optional render service) ──────────────
SHORT_VIDEO_MAKER_URL=http://localhost:3000

# ── Cloudflare Tunnel (public URL for Threads video CDN) ──────
CLOUDFLARE_TUNNEL_URL=

# ── Prefect orchestration ─────────────────────────────────────
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL=genlab-process-pool
