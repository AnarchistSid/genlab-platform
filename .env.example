# ======================================================================
# Gen Lab -- Shared Platform Credentials
# One .env file at the workspace root, used by ALL agents.
# Never put platform credentials in a niche-specific .env.
# ======================================================================

# ── Infrastructure ─────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_URL=
LOCAL_CDN_PORT=8766
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL=genlab-process-pool
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── AI APIs (shared across all agents) ─────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Meta / Instagram -- one app, all agents ────────────────────────
# EAA Page Token (permanent, never refresh via ig_refresh_token)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_APP_ID=
META_IG_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# ── Meta / Facebook -- same app ────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
META_FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=

# ── Meta Webhooks (dashboard) ──────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=***REMOVED***

# ── YouTube -- one OAuth project, all agents ───────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── X / Twitter -- one developer app, all agents ──────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ── TikTok -- one developer app, all agents ───────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_ISSUED_AT=
TIKTOK_AUDIT_APPROVED=false

# ── Threads -- same Meta app as Instagram ──────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_ISSUED_AT=

# ── Microsoft Graph / SharePoint -- shared data layer ──────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# ── Gaming niche (CriticalRush) ───────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_API_KEY=

# ── Movies niche (SpliceReel) ─────────────────────────────────────
TMDB_API_KEY=
OMDB_API_KEY=

# ── Anime niche (FrameDrift) ──────────────────────────────────────
MAL_CLIENT_ID=

# ── Stock media (fallback sources) ────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── TTS / Audio ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=
RENDER_AUDIO_MODE=

# ── Video rendering ───────────────────────────────────────────────
SHORT_VIDEO_MAKER_URL=http://localhost:3000
FFMPEG_BINARY=
FFPROBE_BINARY=

# ── OpenSandbox (containerized rendering) ─────────────────────────
GENLAB_RENDER_SANDBOX=false
OPENSANDBOX_SERVER=http://127.0.0.1:8080
OPENSANDBOX_RENDER_TTL=300

# ── Postiz (social media scheduling, disabled) ────────────────────
POSTIZ_SHADOW_MODE=false

# ── Dashboard / Review Server ─────────────────────────────────────
FLASK_SECRET_KEY=
REVIEW_AUTH_USER=admin
REVIEW_AUTH_PASS=
SESSION_COOKIE_SECURE=true

# ── Per-niche account IDs (populate when accounts are created) ────
# CriticalRush (Gaming)
CRITICALRUSH_INSTAGRAM_ACCOUNT_ID=
CRITICALRUSH_YOUTUBE_CHANNEL_ID=
CRITICALRUSH_X_ACCOUNT_ID=
CRITICALRUSH_FACEBOOK_PAGE_ID=
CRITICALRUSH_THREADS_ACCOUNT_ID=

# ClutchWire (Sports)
CLUTCHWIRE_INSTAGRAM_ACCOUNT_ID=
CLUTCHWIRE_YOUTUBE_CHANNEL_ID=
CLUTCHWIRE_X_ACCOUNT_ID=
CLUTCHWIRE_FACEBOOK_PAGE_ID=
CLUTCHWIRE_THREADS_ACCOUNT_ID=

# SpliceReel (Movies)
SPLICEREEL_INSTAGRAM_ACCOUNT_ID=
SPLICEREEL_YOUTUBE_CHANNEL_ID=
SPLICEREEL_X_ACCOUNT_ID=
SPLICEREEL_FACEBOOK_PAGE_ID=
SPLICEREEL_THREADS_ACCOUNT_ID=

# FrameDrift (Anime)
FRAMEDRIFT_INSTAGRAM_ACCOUNT_ID=
FRAMEDRIFT_YOUTUBE_CHANNEL_ID=
FRAMEDRIFT_X_ACCOUNT_ID=
FRAMEDRIFT_FACEBOOK_PAGE_ID=
FRAMEDRIFT_THREADS_ACCOUNT_ID=
