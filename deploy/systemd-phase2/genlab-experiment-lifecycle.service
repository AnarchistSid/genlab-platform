[Unit]
Description=GenLab auto-experiment lifecycle runner — start pending, complete due
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=10min
ExecStart=/usr/local/bin/uv run python scripts/run_experiment_lifecycle.py --apply
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=30

[Install]
WantedBy=multi-user.target
