[Unit]
Description=GenLab Engagement Review-Queue Drainer — second-tier LLM re-review
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=10min
ExecStart=/usr/local/bin/uv run python scripts/drain_engagement_review_queue.py --apply
StandardOutput=journal
StandardError=journal

MemoryMax=512M
CPUWeight=30

[Install]
WantedBy=multi-user.target
