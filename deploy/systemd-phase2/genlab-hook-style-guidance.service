[Unit]
Description=GenLab hook style guidance — weekly top-3 hook styles per niche from bandit posteriors
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=3min
ExecStart=/usr/local/bin/uv run python scripts/compute_hook_style_guidance.py
StandardOutput=journal
StandardError=journal

MemoryMax=128M
CPUWeight=20

[Install]
WantedBy=multi-user.target
