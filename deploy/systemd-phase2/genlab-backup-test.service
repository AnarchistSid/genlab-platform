[Unit]
Description=GenLab — weekly backup-restore dry-run validation
After=network-online.target docker.service genlab-pg-backup.service
# Don't run if the backup itself just failed (no point validating a
# missing file); the alerting on genlab-pg-backup.service handles that
# scenario. Wants= rather than Requires= so a manual `systemctl start
# genlab-backup-test.service` still works even when the backup hasn't
# run today.
Wants=genlab-pg-backup.service
# 2026-07-14 fix: OnFailure MUST live under [Unit], not [Service].
# systemd was logging "Unknown key name 'OnFailure' in section
# 'Service', ignoring." on every start — so the failure alert never
# fired despite the script exiting non-zero. Verified in journal:
# ``/etc/systemd/system/genlab-backup-test.service:29: Unknown key
# name 'OnFailure' in section 'Service', ignoring.``
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=HOME=/opt/genlab
ExecStart=/bin/bash /opt/genlab/scripts/test_backup_restore.sh
# 5-minute cap — the COPY-extract + TEMP-table load on the
# 2026-06-29-size backup (1951 blueprints) finishes in <10s. 5 minutes
# is generous headroom for backup growth.
TimeoutSec=300
# A failed test fires the existing failure_alert path (moved to
# [Unit] above per systemd docs). Exit codes from the script:
#   0 = backup is valid
#   1 = backup missing / empty / load failed
#   2 = unexpected error
