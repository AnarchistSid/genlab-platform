[Unit]
Description=GenLab Portfolio Bandit — weekly per-niche budget allocation
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
ExecStart=/usr/local/bin/uv run python scripts/run_portfolio_bandit.py
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=30

[Install]
WantedBy=multi-user.target
