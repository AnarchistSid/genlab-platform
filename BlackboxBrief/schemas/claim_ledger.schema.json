{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim Ledger",
  "description": "Atomic claims with sources and risk classification",
  "type": "object",
  "required": ["story_id", "claims"],
  "properties": {
    "story_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "type", "must_cite", "risk"],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM_[A-Z0-9]{8}$"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "enum": ["fact", "estimate", "prediction", "opinion", "rumor"]
          },
          "must_cite": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "credibility"],
              "properties": {
                "url": {"type": "string", "format": "uri"},
                "title": {"type": "string"},
                "credibility": {
                  "type": "string",
                  "enum": ["primary", "secondary", "tertiary", "unknown"]
                }
              }
            }
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mitigation": {
            "type": "string",
            "description": "How to present if uncertain"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "coverage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "passed": {"type": "boolean"}
      }
    }
  }
}
