[Unit]
Description=GenLab Engagement Worker (Dramatiq)
After=network-online.target docker.service
Requires=docker.service

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=exec
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab/genlab-core
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
# Engagement worker handles comments across all 5 niches and writes to
# a shared .engagement_replied.jsonl idempotency log. AGENT_ROOT must
# point to one consistent location — BlackboxBrief is the canonical
# default agent root for shared state. Without this, every message
# fails with RuntimeError: AGENT_ROOT not set, retry-exhausts, then
# lands in the dead-letter queue. (2026-05-20 forensics: 29k DLQ
# messages, 40 days of broken engagement.)
Environment=AGENT_ROOT=/opt/genlab/BlackboxBrief
Environment=REDIS_HOST=127.0.0.1
Environment=REDIS_PORT=6379
ExecStart=/opt/genlab/.venv/bin/python -m dramatiq \
    genlab_core.engagement.tasks \
    --queues engagement_high engagement_normal engagement_low \
    --processes 1 --threads 2
Restart=always
RestartSec=15
# 2026-08-10: Dramatiq's main process exits with status 1 (not 0, and not
# via signal-delivery) when it receives SIGTERM from `systemctl restart`,
# after sending SIGTERM to its worker subprocesses. Prior to this line,
# every `systemctl restart genlab-engagement-worker.service` fired
# OnFailure → genlab-service-failure-alert@%n.service → a spurious
# systemd_unit_failed CRITICAL row in pipeline_alerts, even though
# Restart=always immediately relaunched the service cleanly. Treat
# exit-1-on-SIGTERM as success so OnFailure only fires on real crashes.
# Trade-off: masks Python-level uncaught exceptions that also exit 1 —
# acceptable because Dramatiq catches actor-level exceptions at the
# @actor decorator boundary, so main-process exit-1 is almost always
# graceful-shutdown. Bootstrap failures (ImportError, missing env) still
# show up in journalctl even if they don't fire the alert.
SuccessExitStatus=1 SIGTERM

[Install]
WantedBy=multi-user.target
