[Unit]
Description=GenLab autonomous flag manager — daily proposal generator for env-flag flips
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=3min
ExecStart=/usr/local/bin/uv run python scripts/autonomous_flag_manager.py
StandardOutput=journal
StandardError=journal

MemoryMax=192M
CPUWeight=15

[Install]
WantedBy=multi-user.target
