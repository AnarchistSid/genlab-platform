[Unit]
Description=GenLab late-window reward re-evaluation
After=network-online.target genlab-postgres.service
Requires=genlab-postgres.service
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=15min
ExecStart=/usr/local/bin/uv run python -m scripts.recompute_late_rewards
StandardOutput=journal
StandardError=journal

MemoryMax=512M
CPUWeight=30

[Install]
WantedBy=multi-user.target
