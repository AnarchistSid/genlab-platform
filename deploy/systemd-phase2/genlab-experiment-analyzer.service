[Unit]
Description=GenLab experiment analyzer — Bayesian A/B verdicts + auto-stop on running auto_experiments
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
ExecStart=/usr/local/bin/uv run python scripts/run_experiment_analyzer.py
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=25

[Install]
WantedBy=multi-user.target
