[Unit]
Description=GenLab scanner — surface stale /opt/genlab/.runtime/*_last_error.txt
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=5min
ExecStart=/usr/local/bin/uv run python scripts/scan_stale_durable_errors.py --apply
StandardOutput=journal
StandardError=journal

MemoryMax=128M
CPUWeight=20

[Install]
WantedBy=multi-user.target
