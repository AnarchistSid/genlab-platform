[Unit]
Description=GenLab operator daily briefing — LLM-synthesized 5-line summary emailed 06:00 UTC
After=network-online.target
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
TimeoutStartSec=3min
ExecStart=/usr/local/bin/uv run python scripts/generate_operator_briefing.py
StandardOutput=journal
StandardError=journal

MemoryMax=256M
CPUWeight=15

[Install]
WantedBy=multi-user.target
