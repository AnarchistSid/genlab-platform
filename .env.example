# ======================================================================
# Gen Lab -- Shared Platform Credentials
# One .env file at the workspace root, used by ALL agents.
# Never put platform credentials in a niche-specific .env.
# ======================================================================

# ── Infrastructure ─────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_URL=
LOCAL_CDN_PORT=8766
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORK_POOL=genlab-process-pool
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── PostgreSQL (primary data store, Sprint 65) ─────────────────────
# REQUIRED: BacklogClient needs BOTH or it falls back to the decommissioned
# SharePoint path and raises ValueError. (R-74 — were missing → setup unrunnable.)
GENLAB_USE_POSTGRES=true
DATABASE_URL=postgresql://genlab:CHANGEME@127.0.0.1:5432/genlab

# ── Alerting / domain ──────────────────────────────────────────────
# Health monitor POSTs CRITICAL alerts here (R-01/R-67). If unset, alerting is
# a SILENT no-op — set it on the host or critical conditions page no one.
GENLAB_ALERT_WEBHOOK_URL=
# Public domain for affiliate click-tracking redirects (R-23): {DOMAIN}/links/go/...
GENLAB_DOMAIN=

# ── AI APIs (shared across all agents) ─────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Meta / Instagram -- one app, all agents ────────────────────────
# EAA Page Token (permanent, never refresh via ig_refresh_token)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_APP_ID=
META_IG_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# ── Meta / Facebook -- same app ────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
META_FB_PAGE_ID=
FB_APP_ID=
FB_APP_SECRET=

# ── Meta Webhooks (dashboard) ──────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=

# ── YouTube -- one OAuth project, all agents ───────────────────────
# Data API v3 key for trending-clip fetch (search/videos.list) — distinct from
# the OAuth creds below, which are for uploading. (R-74 — was missing.)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── X / Twitter -- one developer app, all agents ──────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=

# ── TikTok -- one developer app, all agents ───────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_ISSUED_AT=
TIKTOK_AUDIT_APPROVED=false

# ── Threads -- same Meta app as Instagram ──────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_ISSUED_AT=

# ── Microsoft Graph / SharePoint -- shared data layer ──────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# ── Gaming niche (CriticalRush) ───────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_API_KEY=

# ── Movies niche (SpliceReel) ─────────────────────────────────────
TMDB_API_KEY=
OMDB_API_KEY=

# ── Anime niche (FrameDrift) ──────────────────────────────────────
MAL_CLIENT_ID=

# ── Stock media (fallback sources) ────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── TTS / Audio ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=
RENDER_AUDIO_MODE=

# ── Video rendering ───────────────────────────────────────────────
SHORT_VIDEO_MAKER_URL=http://localhost:3000
FFMPEG_BINARY=
FFPROBE_BINARY=

# ── OpenSandbox (containerized rendering) ─────────────────────────
GENLAB_RENDER_SANDBOX=false
OPENSANDBOX_SERVER=http://127.0.0.1:8080
OPENSANDBOX_RENDER_TTL=300

# ── Postiz (social media scheduling, disabled) ────────────────────
POSTIZ_SHADOW_MODE=false

# ── Dashboard / Review Server ─────────────────────────────────────
FLASK_SECRET_KEY=
REVIEW_AUTH_USER=admin
REVIEW_AUTH_PASS=
SESSION_COOKIE_SECURE=true

# ── Per-niche account IDs (populate when accounts are created) ────
# CriticalRush (Gaming)
CRITICALRUSH_INSTAGRAM_ACCOUNT_ID=
CRITICALRUSH_YOUTUBE_CHANNEL_ID=
CRITICALRUSH_X_ACCOUNT_ID=
CRITICALRUSH_FACEBOOK_PAGE_ID=
CRITICALRUSH_THREADS_ACCOUNT_ID=

# ClutchWire (Sports)
CLUTCHWIRE_INSTAGRAM_ACCOUNT_ID=
CLUTCHWIRE_YOUTUBE_CHANNEL_ID=
CLUTCHWIRE_X_ACCOUNT_ID=
CLUTCHWIRE_FACEBOOK_PAGE_ID=
CLUTCHWIRE_THREADS_ACCOUNT_ID=

# SpliceReel (Movies)
SPLICEREEL_INSTAGRAM_ACCOUNT_ID=
SPLICEREEL_YOUTUBE_CHANNEL_ID=
SPLICEREEL_X_ACCOUNT_ID=
SPLICEREEL_FACEBOOK_PAGE_ID=
SPLICEREEL_THREADS_ACCOUNT_ID=

# FrameDrift (Anime)
FRAMEDRIFT_INSTAGRAM_ACCOUNT_ID=
FRAMEDRIFT_YOUTUBE_CHANNEL_ID=
FRAMEDRIFT_X_ACCOUNT_ID=
FRAMEDRIFT_FACEBOOK_PAGE_ID=
FRAMEDRIFT_THREADS_ACCOUNT_ID=

# ══════════════════════════════════════════════════════════════════
# INTELLIGENCE ENGINES (2026-07-01→02 sprint)
# ══════════════════════════════════════════════════════════════════
# Every flag is exact-match ``true`` / ``TRUE`` / ``True`` to activate.
# Any other value (``1``, ``yes``, empty, unset) keeps the engine in
# its shipped-but-inactive default state.
#
# Recommended rollout ordering documented in
# ``docs/AGENT-INTELLIGENCE-RESEARCH-2026-07.md`` Appendix D:
#   1. Read/write side (runner + observability card) — always on
#   2. Consumer wire (steering side) — after operator validates the
#      card shows sustained sane values (~1-2 weeks)

# ── Intervention 2 — cross-niche hierarchical Bayes transfer ───────
# Read side gates ``get_transferred_prior`` (module read function).
# When on AND priors artifact exists, new bandit_arms rows inherit
# moment-matched Beta priors from cross-niche observations.
# Weekly refit runner: ``genlab-cross-niche-transfer.timer``
GENLAB_CROSS_NICHE_TRANSFER_ENABLED=false

# ── Intervention 5 — trend anticipation ────────────────────────────
# Steering gate for pipeline candidate reordering. Daily runner
# writes the artifact regardless of this flag; the flag controls
# whether ``TrendingVideoFetcher`` reorders keywords by
# anticipation composite_score.
GENLAB_TREND_ANTICIPATION_ENABLED=false
# Individual paid-signal opt-ins for the anticipation module. Each
# has its own cost profile — YouTube search costs 100 quota units
# per call; Reddit + News are free but respect rate limits.
GENLAB_ANTICIPATION_YT_ENABLED=false
GENLAB_ANTICIPATION_REDDIT_ENABLED=false
GENLAB_ANTICIPATION_NEWS_ENABLED=false
# Session 3b — weekly Spearman validation runner.
GENLAB_ANTICIPATION_ACCURACY_ENABLED=false

# ── Intervention 6 — ensemble decision-making ──────────────────────
# When on, the ``/auto-approval-preview`` endpoint populates the
# ``ensemble`` payload with real votes; EnsembleBadge on Focus
# Review renders accordingly. When off, the badge stays absent
# (recommendation = ``disabled``).
GENLAB_ENSEMBLE_DECISION_ENABLED=false

# ── Intervention 7 — doubly-robust reward estimator ────────────────
# When on, the monthly replay runner fits a Ridge reward model and
# populates ``dr_reward`` per arm. When off, DR fields stay null
# stubs and only IPS values are meaningful. Strategist prompt
# renders "Signal: DR" or "Signal: IPS (DR stub — flag off)"
# accordingly.
GENLAB_COUNTERFACTUAL_REPLAY_ENABLED=false

# ── Intervention 9 — cyclical time context (v2 vector) ─────────────
# Reserved for the future LinUCB-v2 retrain PR. v1 (13-D) LinUCB
# decision path is unaffected. Ancillary consumers (DR, ensemble)
# opt into v2 automatically via ``linucb_context_v2`` in the
# bandit_context JSONB — no flag needed for read side.
GENLAB_TEMPORAL_CONTEXT_ENABLED=false

# ── Intervention 1 — multi-window reward re-evaluation ─────────────
# Daily 04:00 UTC runner. When on, computes reward at 7d window
# and issues bandit updates for arms whose 48h reward changed
# significantly.
GENLAB_MULTI_WINDOW_REWARD_ENABLED=false

# ── LLM-as-judge escalation (auto-approval gate + ensemble) ────────
# Cost ~$0.10/day at typical borderline volume. Recommended for
# gaming niche (broken rule gate → LLM judge lifts agreement to
# ~85%). See ``[[gaming-auto-approval-gate-broken]]`` memory.
GENLAB_LLM_JUDGE_ENABLED=false

# ── Bayesian gate (per-niche LR posterior) ─────────────────────────
# When on, auto-approval gate samples Thompson from the fitted
# per-niche posterior. Refit runs nightly.
GENLAB_BAYESIAN_GATE_ENABLED=false

# ── Conformal selective router ─────────────────────────────────────
# When on, the router adds an ``auto_reject`` / ``auto_approve``
# opinion to the gate cascade based on the per-niche calibration
# set's non-conformity quantile.
GENLAB_CONFORMAL_ROUTER_ENABLED=false

# ── LinUCB stochastic mode (IPS-friendly) ──────────────────────────
# Default OFF — deterministic argmax preserves reward semantics
# of every historical observation. Only flip when the IPS/DR
# replay path is ready to consume propensity-weighted decisions.
GENLAB_LINUCB_STOCHASTIC_ENABLED=false
GENLAB_LINUCB_TEMPERATURE=0.5

# ── Optimal-time bandit (per-hour Thompson posterior) ──────────────
# When on, replaces the fixed 06:30 UTC publish slot with a
# per-niche per-platform hour posterior draw. Requires ≥30
# observations per (niche, hour, platform) — check
# ``BanditHourHeatmap`` for readiness.
GENLAB_OPTIMAL_TIME_BANDIT_ENABLED=false
