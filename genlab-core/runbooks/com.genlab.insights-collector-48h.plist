<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.genlab.insights-collector-48h</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/anarchistsid/GenLab/scripts/collect_all_insights.sh</string>
        <string>--window</string>
        <string>48</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/anarchistsid/GenLab</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/anarchistsid/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/anarchistsid</string>
    </dict>
    <!-- 48h after publish = 06:30 UTC two days later -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>35</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/insights_collector_48h.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/anarchistsid/GenLab/.logs/insights_collector_48h_error.log</string>
    <key>TimeOut</key>
    <integer>600</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
