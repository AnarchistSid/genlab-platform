[Unit]
Description=GenLab AUTO #2 Auto-Approval Worker (enforce mode; per-niche via publishing.yaml)
After=network-online.target genlab-postgres-ready.target

# Surface unit failures to the dashboard CriticalAlertsBanner
# (2026-06-16 outage prevention). Template unit lives at
# scripts/systemd_failure_alert.sh.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
# AUTO #2 D3.9 (2026-06-15): periodic worker that walks every niche's
# VISUAL_READY blueprints and calls run_pass(). The worker is gated by
# THREE independent safety knobs that must ALL line up for any approval
# to fire:
#
#   1. Per-niche `auto_publish.enabled: true` in publishing.yaml
#      (default false — operator's Day-8 flip step)
#   2. GENLAB_AUTO_APPROVE_DISABLED env var NOT set (kill switch)
#   3. Gate confidence ≥ policy.min_confidence (today 0.85)
#
# ENFORCE MODE ENABLED 2026-07-06 (Path A of autonomous-publishing arc).
# --dry-run REMOVED — enforcement now gated purely by publishing.yaml
# per-niche auto_publish.enabled + rollout_pct. Today the only niche
# with enabled=true is ai_creators (rollout_pct=0.1). Other 4 niches
# have enabled=false and are untouched by this worker; they get
# scheduled by the Path B nightly cron (genlab-nightly-schedule.timer).
#
# To re-enable dry-run globally (emergency rollback):
#   1. Add ``--dry-run`` back to ExecStart via PR
#   2. Or set GENLAB_AUTO_APPROVE_DISABLED=1 in /opt/genlab/.env (kill switch)
#
# Kill switches still active:
#   systemctl stop genlab-auto-approver.timer
#   echo 'GENLAB_AUTO_APPROVE_DISABLED=1' >> /opt/genlab/.env
#   touch /opt/genlab/.runtime/auto_approve_kill_switch
ExecStart=/opt/genlab/.venv/bin/python -m genlab_core.scheduling.auto_approver --niche all
TimeoutSec=300
# Per-niche failures don't fail the whole exec — run_pass returns
# exit_code=1 only if a niche had errors, but the work for OTHER niches
# already happened. Surface to systemd so the alert wires fire on
# repeated failures.

[Install]
WantedBy=multi-user.target
