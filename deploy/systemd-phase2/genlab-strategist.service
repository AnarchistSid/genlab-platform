[Unit]
Description=GenLab Strategist — weekly LLM-based meta-cognition per niche
After=network-online.target genlab-postgres.service
Wants=network-online.target
Requires=genlab-postgres.service
# Surface unit failures to the dashboard CriticalAlertsBanner
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=UV_FROZEN=1
# Strategist calls the LLM at most once per niche per week, so a
# generous timeout is fine — it's not going to hog resources.
TimeoutStartSec=15min
ExecStart=/usr/local/bin/uv run python -m scripts.run_strategist
StandardOutput=journal
StandardError=journal

# Resource caps — Strategist is a Python + HTTP process, never
# renders video, so tight limits are safe.
MemoryMax=512M
CPUWeight=50

[Install]
WantedBy=multi-user.target
