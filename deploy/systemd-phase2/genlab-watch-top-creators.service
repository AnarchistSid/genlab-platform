[Unit]
Description=GenLab top-tier creator upload watcher — leading trend indicator
Documentation=file:///opt/genlab/scripts/watch_top_creator_uploads.py
After=network-online.target

# 2026-07-14: mass OnFailure coverage — every genlab service
# should route failures to the shared failure-alert template so
# systemd_unit_failed critical alerts land in pipeline_alerts.
OnFailure=genlab-service-failure-alert@%n.service

[Service]
Type=oneshot
User=genlab
Group=genlab
WorkingDirectory=/opt/genlab
EnvironmentFile=/opt/genlab/.env
Environment=GENLAB_PROJECT_ROOT=/opt/genlab
Environment=HOME=/opt/genlab
Environment=GENLAB_TMP=/opt/genlab/.tmp
# A.2 (2026-07-07) — polls per-niche top-tier YouTube creators for
# their most recent uploads. When a top creator publishes about
# topic X, X is trending several hours before Google Trends catches
# it. Feeds into TrendAnticipation via A.3 (follow-up).
#
# Quota cost: ~40 units/day of 10K daily YouTube API budget.
# Cached uploads-playlist-id lookup keeps steady-state at 1 unit per
# creator per poll instead of 2.
#
# GENLAB_TOP_CREATORS_ENABLED is the activation flag — off by default.
# When operator flips it, artifacts start landing at
# $GENLAB_TMP/top-creator-uploads/YYYYMMDD-<niche>.json.
#
# File-path invocation — scripts/ is not a Python package. See
# tests/runbooks/test_systemd_module_drift.py for the CI regression.
ExecStart=/opt/genlab/.venv/bin/python scripts/watch_top_creator_uploads.py
TimeoutSec=600

[Install]
WantedBy=multi-user.target
